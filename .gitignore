# local environment for scripts/mowflop
.venv/

# raw_results/ (logs brutos da campanha + dado vendorizado wflopcec26) é
# commitado de propósito, não ignorado -- mesmo padrão de STN_MoWFLOP e
# wflopcec26: git é o caminho de transferência pro supercomputador.
#
# EXCEÇÃO (2026-09-02): o output STN esparso (r1e-04 / r1e-05, wind-corrected)
# fica só em disco + supercomputer_backup + tars no Drive, NÃO versionado,
# enquanto não se decide com o Arthur se vai por git-lfs / rsync / commit
# direto (~3 GB). As famílias ns* (STN10) continuam commitadas normalmente.
raw_results/meta_heuristics_stn_windcorrected/moead/*_r1e-0*/
raw_results/meta_heuristics_stn_windcorrected/nsga2/*_r1e-0*/
raw_results/meta_heuristics_stn_windcorrected/candidates/*_r1e-0*_candidates.csv

# generated by the partitioning stage
data/mowflop_*/
pf/mowflop/
locations/
stns/mowflop_*/
plots/mowflop_*/
reports/

# scratch output of scripts/mowflop_comparison/pareto_check.py
# (curated copies are committed under sharing/pareto_front_vs_cec/)
plots/pareto_check/

# saída de scripts/run_entropy_campaign.sh
logs/
status/

__pycache__/
*.pyc
Rplots.pdf

# local reorg of pre/post-wind-fix STN outputs, mirrors the Drive backup archive
_local_output_archive/
