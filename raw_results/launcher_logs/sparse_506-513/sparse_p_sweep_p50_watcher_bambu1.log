##### p50_watcher.sh
#!/usr/bin/env bash
# Resumes the SIGSTOPped NSGA-II 513 p50 runs of the psweep container as the
# p10 runs finish, so freed cores don't sit idle. Least-advanced run first
# (longest remaining work). Cap: 30 running nsga2 while any p10 is alive
# (leaves headroom so p10 stays fast), 32 after that (physical cores).
# v2 (2026-09-26 11:40): each run_id has ONE designated server. bambu1 only
# resumes ALLOW_RUNS (the 12 most advanced); runs 1,3,7-11,17,20-29 belong to
# bambu3 (feeder ~/p50_b3_feeder.sh there) and stay paused here as a fallback.
# Started 2026-09-26. Log: ~/p50_watcher.log. Stop: kill $(cat ~/p50_watcher.pid)
PIDFILE=~/psweep_p50_paused_pids.txt
LOG=~/p50_watcher.log
ALLOW_RUNS=" 0 2 4 5 6 12 13 14 15 16 18 19 "
HOST_SRC=~/STN_MoWFLOP/source_code   # container cwd /work/source_code == this
echo $$ > ~/p50_watcher.pid
log() { echo "$(date -Iseconds) $*" >> "$LOG"; }
run_id_of() { tr '\0' ' ' < /proc/$1/cmdline | grep -oE 'p50_i50/[0-9]+' | cut -d/ -f2; }
evals_of() {
  local out
  out=$(tr '\0' '\n' < /proc/$1/cmdline | sed -n 3p)   # ../raw_results/.../<run>/
  tail -1 "$HOST_SRC/$out/infoRun.txt" 2>/dev/null | sed -E 's/.*Revalues: ([0-9]+).*/\1/'
}
log "watcher v2 started (allow:$ALLOW_RUNS)"
while true; do
  running=0; p10=0; candidates=()
  for p in $(pgrep -u "$USER" -x nsga2); do
    st=$(ps -o stat= -p "$p" | cut -c1)
    if grep -q p10_i50 /proc/$p/cmdline 2>/dev/null; then p10=$((p10+1)); fi
    if [[ "$st" != "T" ]]; then running=$((running+1)); continue; fi
    grep -qx "$p" "$PIDFILE" || continue          # only touch the ones we paused
    r=$(run_id_of "$p")
    [[ "$ALLOW_RUNS" == *" $r "* ]] || continue
    candidates+=("$(evals_of "$p") $p $r")
  done
  if [[ ${#candidates[@]} -eq 0 ]]; then
    log "nothing left to resume (running=$running p10=$p10), exiting"
    rm -f ~/p50_watcher.pid
    exit 0
  fi
  cap=32; (( p10 > 0 )) && cap=30
  free=$((cap - running))
  if (( free > 0 )); then
    while read -r ev p r; do
      kill -CONT "$p" && log "resumed p50 run $r (pid $p, evals $ev) running=$running p10=$p10 cap=$cap"
      running=$((running+1))
    done < <(printf '%s\n' "${candidates[@]}" | sort -n | head -n "$free")
  fi
  sleep 300
done
