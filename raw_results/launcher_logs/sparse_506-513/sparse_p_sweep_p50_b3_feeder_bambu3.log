##### p50_b3_feeder.sh
#!/usr/bin/env bash
# Keeps bambu3's 4 cores busy with NSGA-II 513_e-05 p50 runs, taken from a
# priority queue (least advanced on bambu1 first). bambu3 runs NSGA-II ~10x
# faster per run than bambu1, so a fresh run here beats finishing it there.
# For each run_id, whichever server finishes first is the copy we keep.
# Started 2026-09-26. Log: ~/p50_b3_feeder.log. Stop: kill $(cat ~/p50_b3_feeder.pid)
#   ~/p50_b3_queue.txt  run_ids in priority order (edit freely; first line = next)
#   ~/p50_b3_skip.txt   run_ids to never start here (e.g. already finished on bambu1)

MAX=4                                   # per-user CPU quota on bambu3 = 4 cores
QUEUE=~/p50_b3_queue.txt
SKIP=~/p50_b3_skip.txt
LOG=~/p50_b3_feeder.log
COMBOS=~/STN_MoWFLOP/source_code/sparse_combos_all.txt
RUNDIR=~/STN_MoWFLOP/raw_results/meta_heuristics_stn_windcorrected/nsga2/513_e-05/p50_i50
echo $$ > ~/p50_b3_feeder.pid
touch "$SKIP"

log() { echo "$(date -Iseconds) $*" >> "$LOG"; }

log "feeder started"
while true; do
  running=$(pgrep -u "$USER" -x nsga2 | wc -l)
  while (( running < MAX )); do
    next=""
    for r in $(cat "$QUEUE"); do
      grep -qx "$r" "$SKIP" && continue
      [[ -d "$RUNDIR/$r" ]] && continue          # already started or done here
      next=$r; break
    done
    if [[ -z "$next" ]]; then
      if (( running == 0 )); then log "queue empty and nothing running, exiting"; rm -f ~/p50_b3_feeder.pid; exit 0; fi
      break
    fi
    line=$(grep -E "^513_e-05 nsga2 $next [^ ]+ [^ ]+ 50$" "$COMBOS")
    if [[ -z "$line" ]]; then log "no combo line for run $next, skipping"; echo "$next" >> "$SKIP"; continue; fi
    read -r inst algo run angle wind p <<< "$line"
    podman run -d --name "p50_b3_r$run" -v ~/STN_MoWFLOP:/work -w /work/source_code \
      localhost/sparse-campaign ./meta_heuristics/scripts/run_one_windcorrected.sh \
      "$inst" "$algo" "$run" "$angle" "$wind" 1000000 "$p" 50 > /dev/null \
      && log "started run $run (angle=$angle wind=$wind) running=$((running+1))" \
      || log "FAILED to start run $run"
    sleep 5
    running=$(pgrep -u "$USER" -x nsga2 | wc -l)
  done
  sleep 300
done
